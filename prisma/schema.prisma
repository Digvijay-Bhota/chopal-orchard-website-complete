generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  phone        String?       @unique
  firstName    String
  lastName     String
  role         UserRole      @default(CUSTOMER)
  avatar       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  password     String?
  b2bInquiries B2BInquiry[]
  orders       Order[]
  reviews      Review[]
  tourBookings TourBooking[]

  @@map("users")
}

model Product {
  id             String              @id @default(cuid())
  slug           String              @unique
  name           String
  variety        AppleVariety
  tagline        String
  description    String
  shortDesc      String
  pricePerKg     Decimal             @db.Decimal(10, 2)
  comparePrice   Decimal?            @db.Decimal(10, 2)
  stockKg        Decimal             @db.Decimal(10, 2)
  isAvailable    Boolean             @default(true)
  isPreOrder     Boolean             @default(false)
  preOrderOpens  DateTime?
  preOrderCloses DateTime?
  harvestStart   DateTime?
  harvestEnd     DateTime?
  sweetness      Int                 @default(7)
  crispness      Int                 @default(8)
  acidity        Int                 @default(6)
  images         String[]
  videoUrl       String?
  originStory    String?
  altitudeMeters Int?
  treeAgeYears   Int?
  certifications String[]
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  batches        BatchTraceability[]
  orderItems     OrderItem[]
  reviews        Review[]

  @@map("products")
}

model BatchTraceability {
  id              String    @id @default(cuid())
  batchCode       String    @unique
  productId       String
  harvestDate     DateTime
  treeBlock       String
  farmerName      String
  farmerNotes     String?
  altitudeMeters  Int
  weatherHarvest  String?
  pickedBy        String[]
  packedDate      DateTime
  packedBy        String
  coldStorageDays Int       @default(0)
  certifications  String[]
  images          String[]
  qrCodeUrl       String?
  isVerified      Boolean   @default(false)
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("batch_traceability")
}

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique
  userId            String?
  guestEmail        String?
  guestPhone        String?
  guestName         String?
  status            OrderStatus   @default(PENDING)
  paymentStatus     PaymentStatus @default(PENDING)
  paymentId         String?
  paymentMethod     String?
  subtotal          Decimal       @db.Decimal(10, 2)
  shippingCost      Decimal       @db.Decimal(10, 2)
  tax               Decimal       @db.Decimal(10, 2)
  total             Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  shippingName      String
  shippingAddress   String
  shippingCity      String
  shippingState     String
  shippingPincode   String
  shippingPhone     String
  deliveryDate      DateTime?
  trackingNumber    String?
  trackingUrl       String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  razorpayOrderId   String?
  razorpayPaymentId String?
  items             OrderItem[]
  user              User?         @relation(fields: [userId], references: [id])

  @@map("orders")
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String
  batchCode  String?
  quantityKg Decimal @db.Decimal(10, 2)
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model B2BInquiry {
  id                  String         @id @default(cuid())
  inquiryNumber       String         @unique
  userId              String?
  companyName         String
  contactName         String
  email               String
  phone               String
  designation         String?
  businessType        BusinessType
  annualVolumeKg      Decimal        @db.Decimal(12, 2)
  targetPrice         Decimal?       @db.Decimal(10, 2)
  varieties           AppleVariety[]
  deliveryCity        String
  deliveryState       String
  deliveryPincode     String
  packagingType       PackagingType  @default(CARTON_10KG)
  deliveryFrequency   String         @default("MONTHLY")
  startDate           DateTime
  contractMonths      Int            @default(12)
  specialRequirements String?
  status              InquiryStatus  @default(NEW)
  assignedTo          String?
  notes               String?
  responseSentAt      DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  user                User?          @relation(fields: [userId], references: [id])

  @@map("b2b_inquiries")
}

model TourBooking {
  id                  String        @id @default(cuid())
  bookingNumber       String        @unique
  userId              String?
  guestName           String
  guestEmail          String
  guestPhone          String
  guestCount          Int
  tourDate            DateTime
  tourSlot            TourSlot
  tourType            TourType      @default(HARVEST_WALK)
  dietaryRestrictions String?
  specialRequests     String?
  amount              Decimal       @db.Decimal(10, 2)
  paymentStatus       PaymentStatus @default(PENDING)
  paymentId           String?
  status              BookingStatus @default(CONFIRMED)
  checkedIn           Boolean       @default(false)
  checkedInAt         DateTime?
  rating              Int?
  feedback            String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  user                User?         @relation(fields: [userId], references: [id])

  @@map("tour_bookings")
}

model Review {
  id         String   @id @default(cuid())
  userId     String?
  productId  String?
  rating     Int
  title      String?
  body       String
  images     String[]
  isVerified Boolean  @default(false)
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())
  product    Product? @relation(fields: [productId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])

  @@map("reviews")
}

model NotificationLog {
  id        String           @id @default(cuid())
  type      NotificationType
  recipient String
  subject   String?
  body      String
  status    String           @default("PENDING")
  error     String?
  sentAt    DateTime?
  createdAt DateTime         @default(now())

  @@map("notification_logs")
}

model WeatherCache {
  id          String   @id @default(cuid())
  location    String   @default("Chopal, Himachal Pradesh")
  temperature Float
  feelsLike   Float
  humidity    Int
  windSpeed   Float
  condition   String
  icon        String
  elevation   Int      @default(2300)
  fetchedAt   DateTime @default(now())

  @@map("weather_cache")
}

enum UserRole {
  CUSTOMER
  WHOLESALER
  ADMIN
  FARMER
}

enum AppleVariety {
  ROYAL_DELICIOUS
  RED_DELICIOUS
  GOLDEN_DELICIOUS
  DARK_BARON
  FUJI
  GRANNY_SMITH
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum BusinessType {
  RETAIL_CHAIN
  HOTEL_RESTAURANT
  EXPORTER
  PROCESSOR
  DISTRIBUTOR
  ONLINE_STORE
  OTHER
}

enum PackagingType {
  CARTON_5KG
  CARTON_10KG
  CARTON_15KG
  WOODEN_CRATE_20KG
  CUSTOM
}

enum InquiryStatus {
  NEW
  UNDER_REVIEW
  QUOTE_SENT
  NEGOTIATING
  APPROVED
  REJECTED
  CONVERTED
}

enum TourSlot {
  MORNING_9AM
  AFTERNOON_2PM
  SUNSET_5PM
}

enum TourType {
  HARVEST_WALK
  PHOTOGRAPHY_TOUR
  FAMILY_PICNIC
  CORPORATE_RETREAT
  APPLE_PICKING
}

enum BookingStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum NotificationType {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}
